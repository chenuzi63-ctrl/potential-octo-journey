<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/barRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_bar"
    android:padding="4dp">

    <TextView
        android:id="@+id/barDragHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="6dp"
        android:text="⠿"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnBarStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="4dp"
        android:text="▶" />

    <Button
        android:id="@+id/btnBarAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="4dp"
        android:text="＋" />

    <Button
        android:id="@+id/btnBarRemove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="4dp"
        android:text="－" />

    <Button
        android:id="@+id/btnBarEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="4dp"
        android:text="定位" />

    <Button
        android:id="@+id/btnBarSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="4dp"
        android:text="⚙" />

    <Button
        android:id="@+id/btnBarClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="4dp"
        android:text="×" />
</LinearLayout>
